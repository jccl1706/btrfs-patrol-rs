post_install() {
  cat <<'MSG'
==> btrfs-patrol: snapshots are taken before every pacman transaction from now on.
==> Run 'sudo btrfs-patrol setup' once: it checks the layout, makes the snapshot
==> store readable only by root and enables the daily snapshot timer.
==> Then 'sudo btrfs-patrol tui'.
MSG
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  echo "==> btrfs-patrol: run 'sudo btrfs-patrol setup' - it only does what is new or missing."
}
